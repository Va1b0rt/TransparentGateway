# Required: only traffic from this explicitly authorised client subnet is intercepted.
CLIENT_CIDR=192.168.88.0/24
VALIDATOR_REDIS_URL=redis://redis:6379/0
GATEWAY_REDIS_URL=redis://127.0.0.1:6379/0
POOL_SIZE=150
RESERVE_SIZE=700
MIN_SCORE_THRESHOLD=0
UNKNOWN_ASN_PENALTY=2
MAX_UNKNOWN_ASN_RATIO=0.1
VALIDATION_CONCURRENCY=100
VALIDATION_INTERVAL_SECONDS=300
# URL of an operator-controlled JSON echo endpoint. It must return backend_peer
# and headers; test-echo.py implements this contract for the isolated lab.
ANONYMITY_CHECK_URL=http://10.10.10.2:8000/
# Optional additional direct/NAT addresses whose appearance means identity leak.
ANONYMITY_CLIENT_IPS=
PROXY_VALIDATION_TIMEOUT_SECONDS=8
ASN_MAX_DATABASE_AGE_SECONDS=259200
ASN_UPDATE_INTERVAL_SECONDS=86400
# PDDL-licensed local ASN database and its published SHA-256 checksum.
ASN_DATABASE_URL=https://github.com/sapics/ip-location-db/releases/download/latest/origin-asn.mmdb
ASN_CHECKSUM_URL=https://github.com/sapics/ip-location-db/releases/download/checksum/origin-asn.mmdb.sha256
FETCH_INTERVAL_SECONDS=900
RANK_INTERVAL_SECONDS=60
# Queries sent to these destination addresses use the local DoH relay. Any other
# UDP/53 destination keeps its original resolver and is converted to DNS-over-TCP.
# Both relay TCP sockets are marked and routed through the upstream proxy.
DNS_DEFAULT_RESOLVER_IPS=1.1.1.1,1.0.0.1
DNS_TCP_TIMEOUT_SECONDS=8
DNS_MAX_CONCURRENCY=256
DNS_DOH_IP=1.1.1.1
DNS_DOH_SERVER_NAME=cloudflare-dns.com
# Optional token used only when an active http_json_feed connector references it.
PROVIDER_API_TOKEN=
